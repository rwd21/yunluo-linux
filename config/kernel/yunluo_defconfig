# Yunluo (Redmi Pad) Kernel Configuration
# Based on defconfig for MediaTek MT6789 (Helio G99)

# System Type
CONFIG_ARM64=y
CONFIG_ARCH_MEDIATEK=y

# CPU Features
CONFIG_NR_CPUS=8
CONFIG_SMP=y
CONFIG_HOTPLUG_CPU=y

# Power Management
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_SUSPEND=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPUFREQ_DT=y
CONFIG_ARM_MEDIATEK_CPUFREQ=y

# Modules
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y

# Block Layer
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_RAM=y

# Filesystems
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# Device Drivers - Storage
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MTK=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# Device Drivers - USB
CONFIG_USB=y
CONFIG_USB_STORAGE=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_MTK_HDRC=y

# Device Drivers - Display
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_MEDIATEK=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_LOGO=y

# Device Drivers - Input
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_MTK=y

# Device Drivers - Wireless
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_MT76=m
CONFIG_MT76_SDIO=m
CONFIG_MT7921S=m

# Device Drivers - Bluetooth
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_MTK=y

# Device Drivers - Audio
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_MT6789=y
CONFIG_SND_SOC_MTK_BTCVSD=y

# Device Drivers - GPU
CONFIG_DRM_PANFROST=m

# Device Drivers - I2C
CONFIG_I2C=y
CONFIG_I2C_MT65XX=y

# Device Drivers - SPI
CONFIG_SPI=y
CONFIG_SPI_MT65XX=y

# Device Drivers - GPIO
CONFIG_GPIOLIB=y
CONFIG_GPIO_SYSFS=y

# Device Drivers - RTC
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_MT6397=y

# Device Drivers - Thermal
CONFIG_THERMAL=y
CONFIG_CPU_THERMAL=y
CONFIG_THERMAL_DEFAULT_GOV_STEP_WISE=y

# Device Drivers - Sensors (IIO)
CONFIG_IIO=y
CONFIG_IIO_BUFFER=y
CONFIG_IIO_TRIGGERED_BUFFER=y

# Networking
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES=y

# Security
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_DEFAULT_SECURITY_SELINUX=y

# Other
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_PRINTK=y
CONFIG_BUG=y

# Debugging (disable for production)
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_DETECT_HUNG_TASK=y

# Disable unused features
# CONFIG_WIRELESS is not set (except what we enabled)
# CONFIG_HAMRADIO is not set
# CONFIG_CAN is not set
